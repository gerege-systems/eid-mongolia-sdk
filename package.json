{
  "name": "@gerege-systems/eid-mongolia-sdk",
  "version": "0.15.0",
  "description": "e-ID Mongolia Relying Party SDK — иргэнээр утсаар нь нэвтрэлт ба хууль ёсны цахим гарын үсэг (RP-API v3, Smart-ID нийцтэй).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./pades": {
      "types": "./dist/pades.d.ts",
      "import": "./dist/pades.js",
      "require": "./dist/pades.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts src/pades.ts --format esm,cjs --dts --clean",
    "test": "npm run build && node --test --experimental-strip-types test/sdk.test.ts test/oidc.test.ts test/portal-gaps.test.ts test/chain.test.ts test/pades-session.test.ts test/pades-golden.test.ts test/pades-unit.test.ts",
    "test:contract": "npm run build && node --experimental-strip-types test/contract.test.ts",
    "lint": "tsc --noEmit",
    "golden:check": "node scripts/sync-pades-golden.mjs --check",
    "size:pades": "node scripts/pades-bundle-size.mjs"
  },
  "keywords": [
    "eid",
    "eid-mongolia",
    "smart-id",
    "eidas",
    "mongolia",
    "authentication",
    "digital-signature",
    "pki",
    "relying-party",
    "pades",
    "pdf-signing"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerege-systems/eid-mongolia-sdk.git"
  },
  "homepage": "https://developer.eidmongolia.mn/",
  "bugs": {
    "url": "https://github.com/gerege-systems/eid-mongolia-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
