{
  "name": "@gerege-systems/eid-mongolia-sdk",
  "version": "0.20.1",
  "description": "e-ID Mongolia Relying Party SDK — иргэнээр утсаар нь нэвтрэлт ба хууль ёсны цахим гарын үсэг (RP-API v3, Smart-ID нийцтэй).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./pades": {
      "types": "./dist/pades.d.ts",
      "import": "./dist/pades.js",
      "require": "./dist/pades.cjs"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.js",
      "require": "./dist/validate.cjs"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js",
      "require": "./dist/button.cjs"
    },
    "./convert": {
      "types": "./dist/convert.d.ts",
      "import": "./dist/convert.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts src/pades.ts src/validate.ts --format esm,cjs --dts --clean && tsup src/button.ts --format esm,cjs --dts --tsconfig tsconfig.button.json && tsup src/convert.ts --format esm --dts --tsconfig tsconfig.button.json",
    "test": "npm run build && node --test --experimental-strip-types test/sdk.test.ts test/portal-gaps.test.ts test/chain.test.ts test/qr.test.ts test/login.test.ts test/button.test.ts test/sign-gaps.test.ts test/session-start.test.ts test/pades-session.test.ts test/pades-golden.test.ts test/pades-unit.test.ts test/convert.test.ts test/share.test.ts test/validate-golden.test.ts test/validate-revisions.test.ts test/validate-env.test.ts test/pades-revocation.test.ts test/pades-encrypt.test.ts test/pades-objstm.test.ts test/validate-fuzz.test.ts",
    "test:contract": "npm run build && node --experimental-strip-types test/contract.test.ts",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.button.json",
    "golden:check": "node scripts/sync-pades-golden.mjs --check",
    "size:pades": "node scripts/pades-bundle-size.mjs",
    "size:validate": "node scripts/pades-bundle-size.mjs validate",
    "test:compat": "node scripts/test-compat.mjs",
    "test:convert-e2e": "npm run build && node scripts/convert-e2e.mjs"
  },
  "keywords": [
    "eid",
    "eid-mongolia",
    "smart-id",
    "eidas",
    "mongolia",
    "authentication",
    "digital-signature",
    "pki",
    "relying-party",
    "pades",
    "pdf-signing"
  ],
  "peerDependencies": {
    "@matbee/libreoffice-converter": "2.7.2"
  },
  "peerDependenciesMeta": {
    "@matbee/libreoffice-converter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@matbee/libreoffice-converter": "2.7.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.0.0",
    "jsdom": "^26.1.0",
    "jsqr": "^1.4.0",
    "playwright": "1.63.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerege-systems/eid-mongolia-sdk.git"
  },
  "homepage": "https://developer.eidmongolia.mn/",
  "bugs": {
    "url": "https://github.com/gerege-systems/eid-mongolia-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "eid-mongolia-convert-assets": "./bin/convert-assets.mjs"
  }
}
